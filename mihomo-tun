# svc <start|stop|restart|status> <routes|mihomo>
# start = 启动并开机自启; stop = 停止并取消开机自启
svc() {
  local act=$1 unit label
  if [ "$2" = routes ]; then unit=$ROUTES_UNIT; label=$ROUTES_LABEL; else unit=$MIHOMO_UNIT; label=$MIHOMO_LABEL; fi
  if [ "$OS" = linux ]; then
    case $act in
      start)   systemctl enable --now "$unit.service" ;;
      stop)    systemctl disable --now "$unit.service" 2>/dev/null ;;
      restart) systemctl restart "$unit.service" ;;
      status)  systemctl --no-pager status "$unit.service" 2>/dev/null | head -5 ;;
    esac
  else
    case $act in
      start)
        launchctl enable "system/$label"
        launchctl bootstrap system "$LAUNCHD_DIR/$label.plist" 2>/dev/null \
          || launchctl kickstart -k "system/$label" ;;
      stop)
        launchctl bootout "system/$label" 2>/dev/null
        launchctl disable "system/$label" ;;
      restart)
        launchctl kickstart -k "system/$label" 2>/dev/null || svc start "$2" ;;
      status)
        if launchctl print "system/$label" >/dev/null 2>&1; then
          launchctl print "system/$label" | awk -v l="$label" '
            /^\tstate =/ || /^\tpid =/ || /^\tlast exit code =/ { sub(/^\t/, ""); s = s "  " $0 }
            END { print l ":" s }'
        else
          echo "$label: 未运行"
        fi ;;
    esac
  fi
}

which_parts() {  # 未指定时默认两者
  case "${1:-}" in
    routes) echo routes ;;
    mihomo) echo mihomo ;;
    ""|all) echo routes mihomo ;;
    *) die "未知的服务: $1 (可选 routes|mihomo)" ;;
  esac
}

# ---------------------------------------------------------------- 命令
# install [--nss-resolve | --no-nss-resolve]
cmd_install() {
  need_root install
  local f nss=ask a
  for a in "$@"; do
    case $a in
      --nss-resolve)    nss=yes ;;
      --no-nss-resolve) nss=no ;;
      *) die "未知参数: $a (可选 --nss-resolve --no-nss-resolve)" ;;
    esac
  done

  # 1) 安装脚本本身
  mkdir -p "$(dirname "$BIN_PATH")"
  if [ "$SELF" != "$BIN_PATH" ]; then install -m 0755 "$SELF" "$BIN_PATH"; fi

  # 2) 配置文件(已存在则不覆盖)
  mkdir -p "$CONF_DIR"; chmod 0755 "$CONF_DIR"
  # 优先用仓库 conf/ 下已编辑好的文件,其次用 .example
  local src
  for f in mihomo-tun.conf proxies.yaml; do
    [ -f "$CONF_DIR/$f" ] && continue
    src=""
    if [ -f "$SELF_DIR/conf/$f" ]; then src=$SELF_DIR/conf/$f
    elif [ -f "$SELF_DIR/conf/$f.example" ]; then src=$SELF_DIR/conf/$f.example; fi
    [ -n "$src" ] || continue
    install -m 0600 "$src" "$CONF_DIR/$f"
    info "已创建 $CONF_DIR/$f (来自 $src)"
  done
  load_conf

  # 3) 系统相关
  if [ "$OS" = linux ]; then
    # 旧版(ts-policy-routing)迁移
    if [ -f /etc/systemd/system/ts-policy-routing.service ]; then
      info "停用旧的 ts-policy-routing.service"
      systemctl disable --now ts-policy-routing.service 2>/dev/null
      rm -f /etc/systemd/system/ts-policy-routing.service /usr/local/sbin/ts-policy-routing.sh
    fi
    if [ -f /etc/systemd/system/mihomo.service ] && grep -Eq '^tun:' /etc/mihomo/config.yaml 2>/dev/null \
       && grep -A1 -E '^tun:' /etc/mihomo/config.yaml | grep -q 'enable: *true'; then
      warn "检测到旧的 mihomo.service 也开启了 TUN,会与本服务冲突,请手动停用: sudo systemctl disable --now mihomo"
    fi
    # systemd-networkd 默认会清掉外部添加的策略路由(需 systemd >= 249)
    if systemctl is-active --quiet systemd-networkd; then
      mkdir -p /etc/systemd/networkd.conf.d
      cat >/etc/systemd/networkd.conf.d/10-mihomo-tun.conf <<'EOF'
# 由 mihomo-tun 安装:防止 systemd-networkd 清掉 Tailscale / mihomo / mihomo-tun 添加的策略路由和路由
[Network]
ManageForeignRoutingPolicyRules=no
ManageForeignRoutes=no
EOF
      systemctl restart systemd-networkd
    fi
  fi
  write_units
  [ "$nss" = no ] || ensure_nss_resolve "$nss"

  # 4) 有配置就先把策略路由跑起来;mihomo 等用户填好节点后再 start
  if [ -n "$TAILNET_CIDRS" ]; then
    svc start routes
  fi
  if [ "$OS" = darwin ]; then
    launchctl disable "system/$MIHOMO_LABEL" 2>/dev/null   # 防止开机时带着示例配置自启
  fi

  cat >&2 <<EOF

[mihomo-tun] 安装完成。接下来:
  1. 编辑 $CONF_FILE   (TAILNET_CIDRS 等网络参数)
  2. 编辑 $PROXIES_FILE   (代理节点 proxies + 分流规则 rules)
  3. 没有 mihomo 时: sudo mihomo-tun fetch-mihomo
  4. sudo mihomo-tun start && mihomo-tun verify
EOF
}

confirm() {  # confirm <提示>;非交互终端下视为拒绝
  local ans
  [ -t 0 ] || return 1
  printf '%s [y/N] ' "$1" >&2
  read -r ans
  case $ans in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

rm_v() {  # 删除并打印
  local f
  for f in "$@"; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    rm -rf "$f" && info "已删除 $f"
  done
}

# uninstall [--purge] [--remove-mihomo] [--all] [-y]
cmd_uninstall() {
  need_root uninstall
  local purge=0 rm_mihomo=0 yes=0 a
  for a in "$@"; do
    case $a in
      --purge)         purge=1 ;;
      --remove-mihomo) rm_mihomo=1 ;;
      --all)           purge=1; rm_mihomo=1 ;;
      -y|--yes)        yes=1 ;;
      *) die "未知参数: $a (可选 --purge --remove-mihomo --all -y)" ;;
    esac
  done
  load_conf

  if [ $purge = 1 ] && [ $yes = 0 ] && [ -d "$CONF_DIR" ]; then
    confirm "将删除配置目录 $CONF_DIR(包含代理节点密码),确定?" \
      || die "已取消(非交互执行时请加 -y)"
  fi

  # 1) 停服务:先停 mihomo(其退出时会自行清理 TUN 和自己的路由),再撤策略路由
  info "停止服务"
  svc stop mihomo
  svc stop routes
  cmd_routes_down        # 服务没装或已失效时也确保规则被删掉

  # 2) 删除服务定义
  if [ "$OS" = linux ]; then
    rm_v /etc/systemd/system/$ROUTES_UNIT.service /etc/systemd/system/$MIHOMO_UNIT.service
    systemctl daemon-reload
    systemctl reset-failed "$ROUTES_UNIT.service" "$MIHOMO_UNIT.service" 2>/dev/null
    if [ -f /etc/systemd/networkd.conf.d/10-mihomo-tun.conf ]; then
      rm_v /etc/systemd/networkd.conf.d/10-mihomo-tun.conf
      rmdir /etc/systemd/networkd.conf.d 2>/dev/null
      # 不立即重启 networkd:重启后它会按默认行为清理 Tailscale 等添加的外部策略路由
      warn "已删除 networkd 配置,下次重启 systemd-networkd(或重启系统)后恢复默认行为"
    fi
    # 旧版残留
    if [ -f /etc/systemd/system/ts-policy-routing.service ]; then
      systemctl disable --now ts-policy-routing.service 2>/dev/null
      rm_v /etc/systemd/system/ts-policy-routing.service
      systemctl daemon-reload
    fi
    rm_v /usr/local/sbin/ts-policy-routing.sh
  else
    rm_v $LAUNCHD_DIR/$ROUTES_LABEL.plist $LAUNCHD_DIR/$MIHOMO_LABEL.plist
    rm_v /var/log/mihomo-tun.log /var/log/mihomo-tun-routes.log
  fi

  revert_nss_resolve
  systemctl stop "$ROLLBACK_UNIT.timer" 2>/dev/null

  # 3) 脚本、运行时状态
  rm_v "$STATE_DIR"
  rm_v "$BIN_PATH"

  # 4) 可选: 配置目录、mihomo 二进制
  if [ $purge = 1 ]; then
    rm_v "$CONF_DIR"
    # MIHOMO_DIR 被改到配置目录之外时也一并删除
    case $MIHOMO_DIR in "$CONF_DIR"/*) ;; *) rm_v "$MIHOMO_DIR" ;; esac
  else
    info "配置保留在 $CONF_DIR(--purge 可一并删除)"
  fi
  if [ $rm_mihomo = 1 ]; then
    rm_v "$MIHOMO_BIN"
  elif [ -e "$MIHOMO_BIN" ]; then
    info "mihomo 二进制保留在 $MIHOMO_BIN(--remove-mihomo 可一并删除)"
  fi

  # 5) 检查残留
  local left=""
  if [ "$OS" = linux ]; then
    left=$(ip -4 rule | awk -F: -v lo="$RULE_PRIORITY_BASE" '$1 >= lo && $1 < lo + 20')
    ip link show "$TUN_DEVICE" >/dev/null 2>&1 && left="$left
TUN 设备 $TUN_DEVICE 仍存在"
  else
    ifconfig "$TUN_DEVICE" >/dev/null 2>&1 && left="TUN 设备 $TUN_DEVICE 仍存在"
  fi
  if [ -n "$left" ]; then
    warn "仍有残留,请手动检查:"; echo "$left" >&2
  else
    info "卸载完成"
  fi
}

# ---------------------------------------------------------------- 分流 DNS
# 系统 DNS 通常是被排除的内网地址,mihomo 拿不到查询,域名规则只能靠 sniffer,
# 而且本地解析不了的域名(只在代理端可解析)根本连不上。
# 这里把规则里的域名交给 mihomo(经 TUN 的 dns-hijack 得到 fake-ip):
#   Linux: systemd-resolved 在 TUN 网卡上设置路由域 ~domain
#   macOS: /etc/resolver/<domain>
split_dns_domains() {
  if [ -n "$SPLIT_DNS_DOMAINS" ]; then echo $SPLIT_DNS_DOMAINS; return; fi
  [ -f "$PROXIES_FILE" ] || return 0
  # 取 DOMAIN / DOMAIN-SUFFIX 且策略不是 DIRECT / TAILSCALE 的规则
  yaml_section "$PROXIES_FILE" rules | normalize_rules \
    | awk -F, -v ts="$TS_DIRECT" -v sys="$SYSTEM_POLICY" '($1 == "DOMAIN-SUFFIX" || $1 == "DOMAIN") && $3 != "DIRECT" && $3 != ts && $3 != sys { print $2 }' \
    | sort -u
}

RESOLVER_MARK="# mihomo-tun"

# Linux: 程序要经过 systemd-resolved 解析,分流 DNS 才生效
# (resolv.conf 指向 127.0.0.53,或 nsswitch 的 hosts 里有 resolve)
split_dns_reachable() {
  [ "$OS" = linux ] || return 0
  grep -Eq '^nameserver[[:space:]]+127\.0\.0\.53' /etc/resolv.conf 2>/dev/null && return 0
  grep -Eq '^hosts:.*[[:space:]]resolve' /etc/nsswitch.conf 2>/dev/null && return 0
  return 1
}
NSS_BACKUP=/etc/nsswitch.conf.mihomo-tun.bak   # 存在即表示 nsswitch 是本脚本改的
NSS_ENTRY='resolve [!UNAVAIL=return]'

# ensure_nss_resolve ask|yes: 让 glibc 经 systemd-resolved 解析(分流 DNS / MagicDNS 依赖它)
ensure_nss_resolve() {
  [ "$OS" = linux ] || return 0
  [ "$SPLIT_DNS" = yes ] || [ "$MAGICDNS_LINK" != no ] || return 0
  systemctl is-active --quiet systemd-resolved || return 0
  split_dns_reachable && return 0
  if ! have apt-get; then warn "$SPLIT_DNS_HINT"; return 0; fi
  if [ "$1" = ask ] && ! confirm "分流 DNS / MagicDNS 需要安装 libnss-resolve 并修改 /etc/nsswitch.conf,现在安装?"; then
    warn "$SPLIT_DNS_HINT(之后可执行: sudo mihomo-tun install --nss-resolve)"; return 0
  fi
  [ -f "$NSS_BACKUP" ] || cp -p /etc/nsswitch.conf "$NSS_BACKUP"
  DEBIAN_FRONTEND=noninteractive apt-get install -y libnss-resolve >/dev/null || { warn "安装 libnss-resolve 失败"; return 1; }
  # 包的安装脚本通常会改好 nsswitch;没改的话手动在 dns 前插入
  if ! split_dns_reachable; then
    sed -i -E "/^hosts:/ s/([[:space:]])dns([[:space:]]|\$)/\1$NSS_ENTRY dns\2/" /etc/nsswitch.conf
  fi
  split_dns_reachable && info "已启用 libnss-resolve: $(grep '^hosts:' /etc/nsswitch.conf)(备份 $NSS_BACKUP)"
}

revert_nss_resolve() {
  [ "$OS" = linux ] && [ -f "$NSS_BACKUP" ] || return 0
  sed -i -E "/^hosts:/ s/[[:space:]]*resolve[[:space:]]+\[!UNAVAIL=return\]//" /etc/nsswitch.conf
  rm -f "$NSS_BACKUP"
  info "已从 /etc/nsswitch.conf 去掉 resolve: $(grep '^hosts:' /etc/nsswitch.conf)(libnss-resolve 包保留)"
}

SPLIT_DNS_HINT="程序解析域名不经过 systemd-resolved,分流 DNS 不会生效。可安装 libnss-resolve(会在 /etc/nsswitch.conf 的 hosts 中加入 resolve)"

cmd_dns_up() {
  need_root dns-up
  load_conf
  [ "$SPLIT_DNS" = yes ] || return 0
  local doms d i
  doms=$(split_dns_domains)
  [ -n "$doms" ] || return 0
  if [ "$OS" = linux ]; then
    if ! have resolvectl || ! systemctl is-active --quiet systemd-resolved; then
      warn "systemd-resolved 未运行,跳过分流 DNS"; return 0
    fi
    for i in $(seq 1 30); do ip link show "$TUN_DEVICE" >/dev/null 2>&1 && break; sleep 0.5; done
    ip link show "$TUN_DEVICE" >/dev/null 2>&1 || { warn "TUN 网卡 $TUN_DEVICE 不存在,跳过分流 DNS"; return 1; }
    set --
    for d in $doms; do set -- "$@" "~$d"; done
    resolvectl dns "$TUN_DEVICE" "$TUN_DNS" \
      && resolvectl domain "$TUN_DEVICE" "$@" \
      && resolvectl default-route "$TUN_DEVICE" false \
      || { warn "设置 systemd-resolved 失败"; return 1; }
    resolvectl flush-caches 2>/dev/null
  else
    mkdir -p /etc/resolver
    cmd_dns_down_mac
    for d in $doms; do
      printf '%s\nnameserver %s\n' "$RESOLVER_MARK" "$TUN_DNS" >"/etc/resolver/$d"
    done
    dscacheutil -flushcache 2>/dev/null; killall -HUP mDNSResponder 2>/dev/null
  fi
  info "分流 DNS -> mihomo: $(echo $doms)"
  split_dns_reachable || warn "$SPLIT_DNS_HINT"
}

cmd_dns_down_mac() {
  local f
  for f in $(find /etc/resolver -type f 2>/dev/null); do
    head -1 "$f" | grep -qx "$RESOLVER_MARK" && rm -f "$f"
  done
}

cmd_dns_down() {
  need_root dns-down
  load_conf
  if [ "$OS" = linux ]; then
    have resolvectl && ip link show "$TUN_DEVICE" >/dev/null 2>&1 && resolvectl revert "$TUN_DEVICE" 2>/dev/null
    have resolvectl && resolvectl flush-caches 2>/dev/null
  else
    cmd_dns_down_mac
    dscacheutil -flushcache 2>/dev/null; killall -HUP mDNSResponder 2>/dev/null
  fi
  return 0
}

cmd_routes_up() {
  need_root routes-up
  load_conf; check_conf
  mkdir -p "$STATE_DIR"
  if [ "$OS" = linux ]; then linux_routes_up; else mac_routes_up; fi
}

cmd_routes_down() {
  need_root routes-down
  load_conf
  if [ "$OS" = linux ]; then linux_routes_down; else mac_routes_down; fi
}

ROLLBACK_UNIT=mihomo-tun-rollback

# 解析 start/restart 的参数: [routes|mihomo] [--rollback 分钟]
parse_svc_args() {
  SVC_PART=""; SVC_ROLLBACK=""
  while [ $# -gt 0 ]; do
    case $1 in
      --rollback) SVC_ROLLBACK=${2:-}; shift
                  case $SVC_ROLLBACK in ''|*[!0-9]*) die "--rollback 需要分钟数" ;; esac ;;
      *) SVC_PART=$1 ;;
    esac
    shift
  done
}

# 远程操作时防止网络改坏后失联: N 分钟后自动执行 mihomo-tun stop,确认正常后用 confirm 取消
arm_rollback() {
  [ -n "$1" ] || return 0
  [ "$OS" = linux ] || { warn "--rollback 目前只支持 Linux"; return 0; }
  systemctl stop "$ROLLBACK_UNIT.timer" 2>/dev/null
  systemctl reset-failed "$ROLLBACK_UNIT.service" 2>/dev/null
  systemd-run --quiet --on-active="${1}min" --unit="$ROLLBACK_UNIT" "$BIN_PATH" stop \
    || die "设置自动回滚失败"
  info "已设置 $1 分钟后自动回滚(mihomo-tun stop)。确认一切正常后执行: sudo mihomo-tun confirm"
}

cmd_confirm() {
  need_root confirm
  if systemctl is-active --quiet "$ROLLBACK_UNIT.timer" 2>/dev/null; then
    systemctl stop "$ROLLBACK_UNIT.timer" && info "已取消自动回滚"
  else
    info "没有待执行的自动回滚"
  fi
}

cmd_start() {
  need_root start
  local p
  parse_svc_args "$@"
  load_conf; check_conf
  [ "$(which_parts "$SVC_PART")" ] && arm_rollback "$SVC_ROLLBACK"
  for p in $(which_parts "$SVC_PART"); do
    [ "$p" = mihomo ] && cmd_render       # 先校验,配置错了不启动
    svc start "$p"
    [ "$p" = mihomo ] && [ "$OS" = darwin ] && cmd_dns_up
  done
}

cmd_stop() {
  need_root stop
  local p parts
  parts=$(which_parts "${1:-}")
  # 先停 mihomo 再撤路由
  for p in mihomo routes; do
    case " $parts " in *" $p "*) svc stop "$p" ;; esac
  done
  case " $parts " in *" mihomo "*) [ "$OS" = darwin ] && cmd_dns_down ;; esac
  case " $parts " in *" routes "*) cmd_routes_down ;; esac
}

cmd_restart() {
  need_root restart
  local p
  parse_svc_args "$@"
  load_conf; check_conf
  [ "$(which_parts "$SVC_PART")" ] && arm_rollback "$SVC_ROLLBACK"
  for p in $(which_parts "$SVC_PART"); do
    if [ "$p" = routes ]; then
      cmd_routes_down; svc restart routes
    else
      cmd_render; svc restart mihomo
      [ "$OS" = darwin ] && cmd_dns_up
    fi
  done
}

cmd_status() {
  load_conf
  local ts_if
  echo "== 服务 =="
  svc status routes
  svc status mihomo
  echo
  echo "== Tailscale 网卡 =="
  ts_if=$(ts_iface) && echo "$ts_if" || echo "未找到"
  echo
  echo "== 路由 =="
  if [ "$OS" = linux ]; then linux_routes_show; else mac_routes_show; fi
}

route_dev() {
  if [ "$OS" = linux ]; then
    ip -4 route get "$1" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1
  else
    route -n get "$1" 2>/dev/null | awk '/interface:/{print $2; exit}'
  fi
}

cmd_verify() {
  if [ -f "$CONF_FILE" ] && [ ! -r "$CONF_FILE" ]; then die "无法读取 $CONF_FILE,请用 sudo 运行"; fi
  load_conf
  local ts_if proxy_ip fail=0 mihomo_up=0
  ts_if=$(ts_iface) || ts_if="?"
  proxy_ip=${VERIFY_PROXY_IP:-$(first_server)}
  [ -n "$proxy_ip" ] && is_ipv4 "$proxy_ip" || proxy_ip=""
  ifconfig "$TUN_DEVICE" >/dev/null 2>&1 || ip link show "$TUN_DEVICE" >/dev/null 2>&1 && mihomo_up=1

  check() {  # check <IP> ts|lan|tun <说明>
    local got ok=0
    got=$(route_dev "$1")
    case $2 in
      ts)  [ "$got" = "$ts_if" ] && ok=1 ;;
      lan) [ -n "$got" ] && [ "$got" != "$ts_if" ] && [ "$got" != "$TUN_DEVICE" ] && ok=1 ;;
      tun) [ "$got" = "$TUN_DEVICE" ] && ok=1 ;;
    esac
    [ $ok = 1 ] || fail=1
    printf '%-4s %-18s -> %-12s (%s)\n' "$([ $ok = 1 ] && echo OK || echo FAIL)" "$1" "${got:-?}" "$3"
  }

  echo "== exit node =="
  if [ $EXIT_NODE = 1 ]; then echo "在用 (TUN_RULE_INDEX=${TUN_RULE_INDEX:-默认}, FINAL_POLICY=$FINAL_POLICY)"
  else echo "未用 (FINAL_POLICY=$FINAL_POLICY)"; fi
  if [ -f "$STATE_DIR/exit_node" ] && [ "$(cat "$STATE_DIR/exit_node")" != "$EXIT_NODE" ]; then
    fail=1; echo "FAIL exit node 状态在 mihomo 启动后变了,请执行: sudo mihomo-tun restart"
  fi
  echo
  echo "== 路由走向 (Tailscale: $ts_if, TUN: $TUN_DEVICE) =="
  [ -n "$proxy_ip" ] && check "$proxy_ip" ts "代理节点"
  local c
  for c in $TAILNET_CIDRS; do
    check "${c%/*}" ts "tailnet $c"
  done
  if [ -n "$MAGICDNS_IP" ] && [ -f "$STATE_DIR/magicdns" ] && [ "$(route_dev "$MAGICDNS_IP")" != "$ts_if" ]; then
    # resolved 在 tailscale0 上发查询时绑定网卡,不受路由表影响,只做提示
    printf '%-4s %-18s -> %-12s (%s)\n' WARN "$MAGICDNS_IP" "$(route_dev "$MAGICDNS_IP")" "MagicDNS: 未绑定网卡的程序直接访问会失败,系统解析不受影响"
    ip -4 rule | awk -F: -v lo="$RULE_PRIORITY_BASE" '$1 > 0 && $1 < lo { print "       更靠前的规则: " $0 }'
  elif [ -n "$MAGICDNS_IP" ]; then
    check "$MAGICDNS_IP" ts "MagicDNS"
    if [ "$OS" = linux ] && [ "$(route_dev "$MAGICDNS_IP")" != "$ts_if" ]; then
      echo "     有比 $RULE_PRIORITY_BASE 更靠前的规则覆盖了它(绑定 $ts_if 的 socket,如 resolved / mihomo 的 TAILSCALE 出口,不受影响):"
      ip -4 rule | awk -F: -v lo="$RULE_PRIORITY_BASE" '$1 > 0 && $1 < lo { print "       " $0 }'
    fi
  fi

  local probe
  for probe in 100.99.0.5 10.1.2.3 172.20.0.1 $VERIFY_LAN_IP; do
    local skip=0 in_local=0
    for c in $TAILNET_CIDRS; do in_cidr "$probe" "$c" && skip=1; done
    for c in $LOCAL_CIDRS; do in_cidr "$probe" "$c" && in_local=1; done
    [ $skip = 0 ] && [ $in_local = 1 ] && check "$probe" lan "本地网段"
  done

  if [ $mihomo_up = 1 ]; then
    check 8.8.8.8 tun "公网 -> mihomo TUN"
  else
    echo "--   8.8.8.8            (mihomo TUN 未启动,跳过)"
  fi

  local doms d got
  if [ "$OS" = linux ] && [ -n "$MAGICDNS_IP" ] && [ -f "$STATE_DIR/magicdns" ]; then
    local self peer
    echo
    echo "== MagicDNS (系统解析 tailnet 节点) =="
    self=$(ts_cli status --json 2>/dev/null | sed -n 's/.*"DNSName": *"\([^"]*\)\.".*/\1/p' | head -1)
    peer=$(ts_cli status 2>/dev/null | awk '$1 ~ /^100\./ && NR > 1 { print $2; exit }')
    for d in $self ${self%%.*} $peer; do
      got=$(timeout 8 getent ahostsv4 "$d" 2>/dev/null | awk 'NR == 1 { print $1 }')
      if [ -n "$got" ] && in_cidr "$got" 100.64.0.0/10; then
        printf 'OK   %-34s -> %s\n' "$d" "$got"
      else
        fail=1; printf 'FAIL %-34s -> %s\n' "$d" "${got:-解析失败}"
      fi
    done
  fi

  doms=$(split_dns_domains)
  if [ $mihomo_up = 1 ] && [ "$SPLIT_DNS" = yes ] && [ -n "$doms" ]; then
    echo
    echo "== 分流 DNS (应解析为 fake-ip $FAKE_IP_RANGE) =="
    split_dns_reachable || echo "警告: $SPLIT_DNS_HINT"
    for d in $doms; do
      got=$(getent ahostsv4 "$d" 2>/dev/null | awk 'NR == 1 { print $1 }')
      if [ -n "$got" ] && in_cidr "$got" "$FAKE_IP_RANGE"; then
        printf 'OK   %-24s -> %s\n' "$d" "$got"
      else
        fail=1; printf 'FAIL %-24s -> %s\n' "$d" "${got:-解析失败}"
      fi
    done
  fi

  if [ $mihomo_up = 1 ] && have curl; then
    echo
    echo "== 代理连通性 (经 mixed-port $MIXED_PORT) =="
    local code
    code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' -x "http://127.0.0.1:$MIXED_PORT" "$HEALTH_CHECK_URL")
    echo "$HEALTH_CHECK_URL -> HTTP $code (走哪个出口取决于 rules)"
  fi

  echo
  echo "== 代理流量是否误走物理网卡(访问被代理网站时,应无输出) =="
  local phy
  if [ "$OS" = darwin ]; then set -- $(mac_default_gw); phy=${2:-en0}
  else phy=$(ip -4 route show default table main 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1); fi
  echo "sudo tcpdump -ni ${phy:-<物理网卡>} host ${proxy_ip:-<代理节点IP>}"
  return $fail
}

cmd_fetch_mihomo() {
  need_root fetch-mihomo
  load_conf
  have curl || die "需要 curl"
  local arch ver api json url tmp name
  case "$(uname -m)" in
    x86_64|amd64)  arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv7*)        arch=armv7 ;;
    *) die "不支持的架构: $(uname -m)" ;;
  esac
  ver=${1:-}
  if [ -n "$ver" ]; then api=https://api.github.com/repos/MetaCubeX/mihomo/releases/tags/$ver
  else api=https://api.github.com/repos/MetaCubeX/mihomo/releases/latest; fi
  json=$(curl -fsSL "$api") || die "获取版本信息失败: $api"
  ver=$(echo "$json" | grep -m1 '"tag_name"' | cut -d'"' -f4)
  for name in "mihomo-$OS-$arch-$ver.gz" "mihomo-$OS-$arch-compatible-$ver.gz" "mihomo-$OS-$arch-v1-$ver.gz"; do
    url=$(echo "$json" | grep -o "\"browser_download_url\": *\"[^\"]*/$name\"" | cut -d'"' -f4)
    [ -n "$url" ] && break
  done
  [ -n "$url" ] || die "在 $ver 中没找到 $OS-$arch 的二进制"
  info "下载 $url"
  tmp=$(mktemp -d)
  curl -fL --progress-bar -o "$tmp/mihomo.gz" "${MIHOMO_DOWNLOAD_PREFIX:-}$url" || { rm -rf "$tmp"; die "下载失败"; }
  gunzip "$tmp/mihomo.gz" || { rm -rf "$tmp"; die "解压失败"; }
  mkdir -p "$(dirname "$MIHOMO_BIN")"
  install -m 0755 "$tmp/mihomo" "$MIHOMO_BIN"
  rm -rf "$tmp"
  "$MIHOMO_BIN" -v
}

usage() {
  cat <<EOF
mihomo-tun $VERSION — Tailscale 网络下的 mihomo TUN 全局代理 ($OS)

用法: mihomo-tun <命令> [参数]

  install [选项]          安装脚本、示例配置和系统服务(可重复执行,不覆盖已有配置)
                            --nss-resolve     需要时直接安装 libnss-resolve(默认询问)
                            --no-nss-resolve  不安装
  uninstall [选项]        停止并删除服务、路由规则和脚本(默认保留配置和 mihomo)
                            --purge          同时删除配置目录
                            --remove-mihomo  同时删除 mihomo 二进制
                            --all            等于 --purge --remove-mihomo
                            -y               不再确认
  start   [routes|mihomo] [--rollback 分钟]   启动并设为开机自启(默认两者)
  stop    [routes|mihomo]                   停止并取消开机自启
  restart [routes|mihomo] [--rollback 分钟]   重新生成配置并重启
                          --rollback N: N 分钟后自动 stop,远程操作时防止失联
  confirm                 确认正常,取消自动回滚
  status                  服务状态、Tailscale 网卡、路由
  verify                  检查各网段的实际路由走向
  render                  只生成并校验 mihomo 配置
  routes-up | routes-down 手动添加 / 删除路由规则
  dns-up | dns-down       手动设置 / 撤销分流 DNS
  fetch-mihomo [版本]     从 GitHub 下载 mihomo 到 MIHOMO_BIN(默认最新版)
  run                     (供服务调用)生成配置并以前台方式运行 mihomo

配置目录: $CONF_DIR  (可用环境变量 MIHOMO_TUN_CONF_DIR 覆盖)
  mihomo-tun.conf   网络参数
  proxies.yaml      代理节点(proxies)与分流规则(rules)
EOF
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  install)      cmd_install "$@" ;;
  uninstall)    cmd_uninstall "$@" ;;
  start)        cmd_start "$@" ;;
  stop)         cmd_stop "$@" ;;
  restart)      cmd_restart "$@" ;;
  status)       cmd_status ;;
  verify)       cmd_verify ;;
  render)       need_root render; cmd_render "$@" ;;
  run)          cmd_run ;;
  confirm)      cmd_confirm ;;
  routes-up)    cmd_routes_up ;;
  routes-down)  cmd_routes_down ;;
  dns-up)       cmd_dns_up ;;
  dns-down)     cmd_dns_down ;;
  fetch-mihomo) cmd_fetch_mihomo "$@" ;;
  version|-v|--version) echo "mihomo-tun $VERSION" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
