EOF
    chown root:wheel $LAUNCHD_DIR/$ROUTES_LABEL.plist $LAUNCHD_DIR/$MIHOMO_LABEL.plist
    chmod 0644 $LAUNCHD_DIR/$ROUTES_LABEL.plist $LAUNCHD_DIR/$MIHOMO_LABEL.plist
  fi
