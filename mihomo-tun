Wants=network-online.target $ROUTES_UNIT.service

[Service]
Type=simple
ExecStart=$BIN_PATH run
ExecStartPost=-$BIN_PATH dns-up
ExecStopPost=-$BIN_PATH dns-down
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
  else
    cat >$LAUNCHD_DIR/$ROUTES_LABEL.plist <<EOF
<?xml version="1.0" encoding="UTF-8"?>
