<dict>
  <key>Label</key><string>$ROUTES_LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$BIN_PATH</string><string>routes-up</string></array>
  <key>RunAtLoad</key><true/>
  <!-- 网络变化(切换 Wi-Fi、Tailscale 重连)时重新检查,另外每 60 秒兜底检查一次 -->
  <key>WatchPaths</key>
  <array><string>/Library/Preferences/SystemConfiguration</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/var/log/mihomo-tun-routes.log</string>
  <key>StandardErrorPath</key><string>/var/log/mihomo-tun-routes.log</string>
