[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$BIN_PATH routes-up
ExecStop=$BIN_PATH routes-down

[Install]
WantedBy=multi-user.target tailscaled.service
EOF
    cat >/etc/systemd/system/$MIHOMO_UNIT.service <<EOF
[Unit]
