# 代理节点与分流规则。
# 支持的顶层键: proxies、proxy-groups、rules、rule-providers;其余部分(tun/dns…)由 mihomo-tun 生成。
# 修改后执行: sudo mihomo-tun restart

# ============================================================ 代理节点
# 写法同 mihomo。不需要写 interface-name:server 在 tailnet 内(100.64.0.0/10、TAILNET_CIDRS、*.ts.net)的节点
# 会自动绑定 Tailscale 网卡;其余按公网节点处理,经物理网卡连接(节点里手写了 interface-name 的不改)。
# tailnet 节点的 server 请写 tailnet IP,不要写域名。
proxies:
  - name: node1
    type: ss
    server: 100.81.1.10
    port: 8388
    cipher: aes-128-gcm
    password: "CHANGE_ME"
    udp: true

  # - name: node2
  #   type: socks5
  #   server: 100.81.1.11
  #   port: 1080
  #   udp: true

  # - name: node3
  #   type: vmess
  #   server: 100.81.1.12
  #   port: 443
  #   uuid: 00000000-0000-0000-0000-000000000000
  #   alterId: 0
  #   cipher: auto
  #   tls: true
  #   servername: example.com

# ============================================================ 代理组(可选)
# 写法同 mihomo,原样追加到生成的组后面。已自动生成的组(不要重名):
#   PROXY(所有节点,类型见 mihomo-tun.conf 的 PROXY_GROUP_TYPE)、每个节点一个同名组
# proxies 里可以写节点名、PROXY、DIRECT、TAILSCALE、REJECT 或其他代理组;
# 也可以用 use: [nodes] + filter 按名字正则选节点(nodes 是 proxies 生成的 provider)。组名不能含空格
# 健康检查(url-test / fallback / load-balance):
#   proxies 列出节点时,不写 url / interval 也会检查(默认 generate_204,每 300 秒,lazy 默认开:组近期没被用到时跳过)
#   用 use: [nodes] 时必须写 url 和 interval,否则节点不做检查,挂掉的节点仍会被选中
proxy-groups:
  # - name: AI                   # 规则里写 AI,在面板里切换节点
  #   type: select
  #   proxies: [node1, node2, PROXY]
  # - name: AUTO                 # 自动选延迟最低的节点
  #   type: url-test
  #   use: [nodes]
  #   url: https://www.gstatic.com/generate_204
  #   interval: 300
  #   tolerance: 50
  # - name: FAILOVER             # 按顺序用第一个可用的,都不可用时直连
  #   type: fallback
  #   proxies: [node1, node2, DIRECT]
  #   url: https://www.gstatic.com/generate_204
  #   interval: 300
  # - name: LB                   # 负载均衡:把连接分散到多个节点
  #   type: load-balance
  #   proxies: [node1, node2]
  #   strategy: consistent-hashing # 同一目标固定同一节点(默认);
  #                                # round-robin: 每个连接轮流换节点(接近随机,AI 等校验 IP 的网站慎用);
  #                                # sticky-sessions: 同一来源+目标一段时间内固定同一节点
  #   url: https://www.gstatic.com/generate_204
  #   interval: 300
  # - name: HK                   # 名字匹配正则的节点
  #   type: url-test
  #   use: [nodes]
  #   filter: "(?i)hk|香港"
  #   url: https://www.gstatic.com/generate_204
  #   interval: 300

# ============================================================ 规则集(可选)
# 给下面的 RULE-SET 规则用。path 必须在 mihomo 工作目录内,用 ./ 开头的相对路径。
# http 类型的规则集由 mihomo 下载,proxy 可指定经代理下载。
rule-providers:
  # private-direct:              # 本地文件:放在 <配置目录>/mihomo/ruleset/ 下
  #   type: file
  #   behavior: domain           # domain | ipcidr | classical
  #   format: text               # yaml | text | mrs
  #   path: ./ruleset/direct.txt
  # telegram-ip:                 # 远程规则集,每 24 小时更新
  #   type: http
  #   behavior: ipcidr
  #   format: mrs
  #   url: https://github.com/MetaCubeX/meta-rules-dat/raw/meta/geo/geoip/telegram.mrs
  #   path: ./ruleset/telegram-ip.mrs
  #   interval: 86400
  #   proxy: PROXY

# ============================================================ 分流规则
# 格式: 类型,匹配内容,策略[,参数]。自上而下匹配,命中第一条即停止。
# 策略: PROXY(所有节点组成的组)、DIRECT(物理网卡直连)、REJECT(拒绝)、
#       REJECT-DROP(静默丢弃)、TAILSCALE(经 Tailscale 网卡直连)
#       SYSTEM(按没有 mihomo 时的系统路由走:本地网段直连,其余按 FINAL_POLICY,适合排除系统 agent)
#       也可以直接写节点名(如 node1),把某些流量固定发给指定节点,或写上面 proxy-groups 中的组名
# 已自动加在最前面: ts.net / tailnet 网段 -> TAILSCALE,LOCAL_CIDRS -> DIRECT
# 已自动加在最后面: MATCH,<FINAL_POLICY>(在 mihomo-tun.conf 中设置)
rules:
  # ---------- 域名类(依赖 fake-ip DNS 或 sniffer 拿到域名)
  - DOMAIN,api.ipify.org,PROXY                   # 完全匹配
  - DOMAIN-SUFFIX,google.com,PROXY               # 匹配 google.com 及其所有子域名
  - DOMAIN-SUFFIX,googleapis.com,PROXY
  - DOMAIN-SUFFIX,gstatic.com,PROXY
  - DOMAIN-SUFFIX,googleusercontent.com,PROXY
  - DOMAIN-SUFFIX,youtube.com,PROXY
  - DOMAIN-SUFFIX,github.com,PROXY
  - DOMAIN-SUFFIX,githubusercontent.com,PROXY
  - DOMAIN-KEYWORD,telegram,PROXY                # 域名中包含关键字
  # - DOMAIN-WILDCARD,*.cdn.example.com,PROXY    # 通配符: * 匹配一级,? 匹配一个字符
  # - DOMAIN-REGEX,^ads?\..*$,REJECT             # 正则(慢,尽量少用)

  # ---------- AI 服务(OpenAI / Anthropic)与 AI 编程工具
  # 用 exit node 出网且要求 AI 流量只走 exit node 时,把 PROXY 换成 TAILSCALE
  - PROCESS-PATH-REGEX,/\.local/share/claude/versions/,PROXY   # Claude Code(原生版进程名是版本号)
  - PROCESS-NAME,codex,PROXY
  - PROCESS-NAME,agy,PROXY                                    # Google Antigravity CLI
  - PROCESS-PATH-REGEX,^/Applications/Claude\.app/,PROXY        # Claude 桌面版(含 helper,macOS)
  - PROCESS-PATH-REGEX,^/Applications/ChatGPT\.app/,PROXY       # ChatGPT / Codex 桌面版(含 helper,macOS)
  - PROCESS-PATH-REGEX,^/Applications/Antigravity\.app/,PROXY   # Antigravity 桌面版(含 helper,macOS)
  - PROCESS-PATH-REGEX,/(\.codex|Library/Application Support/Codex)/,PROXY   # Codex 运行时 / computer-use
  - DOMAIN-KEYWORD,anthropic,PROXY
  - DOMAIN-KEYWORD,claude,PROXY
  - DOMAIN-KEYWORD,openai,PROXY
  - DOMAIN-KEYWORD,chatgpt,PROXY
  - DOMAIN-SUFFIX,oaistatic.com,PROXY
  - DOMAIN-SUFFIX,oaiusercontent.com,PROXY
  # 以下补自 https://github.com/ma-wenqian/ai-proxy-rules (Clash/ai-proxy.yaml) 中关键字没覆盖到的部分
  - DOMAIN-SUFFIX,sora.com,PROXY
  - DOMAIN-SUFFIX,livekit.cloud,PROXY                         # ChatGPT 高级语音
  - DOMAIN,cdn.auth0.com,PROXY                                # OpenAI 登录(auth0 多站共用)
  - DOMAIN,client-api.arkoselabs.com,PROXY                    # OpenAI 人机验证(多站共用)
  - DOMAIN-SUFFIX,clau.de,PROXY                               # Claude 短链
  - DOMAIN-SUFFIX,segment.io,PROXY                            # 埋点(多站共用)
  - DOMAIN-SUFFIX,segment.com,PROXY
  - IP-CIDR,160.79.104.0/21,PROXY,no-resolve                  # Anthropic 自有 IP 段(AS399358)
  - IP-CIDR6,2607:6bc0::/32,PROXY,no-resolve

  # ---------- 广告 / 拦截
  # - DOMAIN-SUFFIX,doubleclick.net,REJECT
  # - DOMAIN-KEYWORD,adservice,REJECT-DROP

  # ---------- GEOSITE / GEOIP(首次使用时 mihomo 会下载 geo 数据库)
  # - GEOSITE,cn,DIRECT                          # 国内常见域名
  # - GEOSITE,geolocation-!cn,PROXY              # 国外常见域名
  # - GEOSITE,category-ads-all,REJECT
  # - GEOIP,telegram,PROXY,no-resolve
  # - GEOIP,CN,DIRECT                            # 不加 no-resolve: 域名会先解析出 IP 再匹配

  # ---------- IP 类(加 no-resolve 表示目标是域名时不为了匹配而去解析)
  - IP-CIDR,8.8.8.8/32,PROXY,no-resolve
  - IP-CIDR,91.108.4.0/22,PROXY,no-resolve       # Telegram
  # - IP-CIDR6,2001:b28:f23d::/48,PROXY,no-resolve
  # - IP-SUFFIX,8.8.8.8/24,PROXY,no-resolve      # 只看 IP 的末尾若干位
  # - IP-ASN,13335,PROXY,no-resolve              # 按 AS 号(需要 ASN 数据库)

  # ---------- 规则集(对应上面的 rule-providers)
  # - RULE-SET,private-direct,DIRECT
  # - RULE-SET,telegram-ip,PROXY,no-resolve

  # ---------- 端口 / 协议
  # - DST-PORT,22,DIRECT                         # 目标端口
  # - DST-PORT,6881-6889,DIRECT                  # 端口范围(如 BT)
  # - NETWORK,udp,DIRECT                         # tcp | udp

  # ---------- 来源(本机发起时是本机地址;开 ALLOW_LAN 后可区分局域网设备)
  # - SRC-IP-CIDR,192.168.1.100/32,DIRECT
  # - SRC-PORT,7777,DIRECT
  # - IN-TYPE,TUN,PROXY                          # 入站类型: TUN | MIXED | SOCKS5 | HTTP ...
  # - IN-PORT,7890,PROXY                         # 经 mixed-port 进来的流量

  # ---------- 进程(仅本机流量;Linux 可用 UID)
  # - PROCESS-NAME,curl,PROXY
  # - PROCESS-NAME,Telegram,PROXY                # macOS 下写 App 进程名
  # - PROCESS-PATH,/usr/bin/apt,DIRECT
  # - PROCESS-NAME-REGEX,(?i)chrome,PROXY
  # - UID,1000,PROXY                             # 仅 Linux

  # ---------- 排除某些程序,让它们像没有 mihomo 一样走(策略 SYSTEM)
  # - PROCESS-PATH-REGEX,^/opt/some-agent/,SYSTEM
  # - PROCESS-NAME,some-agent,SYSTEM

  # ---------- 逻辑组合: AND / OR / NOT,每个子规则用括号包起来
  # - AND,((NETWORK,udp),(DST-PORT,443)),REJECT          # 屏蔽 QUIC,迫使浏览器回落到 TCP
  # - OR,((DOMAIN-SUFFIX,x.com),(DOMAIN-SUFFIX,twitter.com)),PROXY
  # - NOT,((DOMAIN-SUFFIX,cn)),PROXY                     # 注意 NOT 很宽泛,一般放在靠后位置
